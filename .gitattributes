# Set default behavior, in case users don't have core.autocrlf set.
* text=auto eol=lf

# ----------------------------------------------------------------------
# Git LFS Large File Tracking
# ----------------------------------------------------------------------
*.msi filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text

# ----------------------------------------------------------------------
# GitHub Linguist Overrides & Language Configuration
# ----------------------------------------------------------------------

# Exclude package locks, build artifacts, vendors and static bundles
package-lock.json linguist-generated=true
dist/** linguist-vendored=true
release/** linguist-vendored=true
public/** linguist-vendored=true
node_modules/** linguist-vendored=true
.system_generated/** linguist-vendored=true

# Exclude HTML files and SVG images from language statistics
*.html linguist-vendored=true
*.htm linguist-vendored=true
*.svg linguist-vendored=true
index.html linguist-vendored=true

# Exclude Markdown documentation
docs/** linguist-documentation=true
*.md linguist-documentation=true

# Explicitly declare primary application development languages
*.ts linguist-language=TypeScript linguist-detectable=true
*.tsx linguist-language=TypeScript linguist-detectable=true
*.css linguist-language=CSS linguist-detectable=true
*.cjs linguist-language=JavaScript linguist-detectable=true
*.js linguist-language=JavaScript linguist-detectable=true
*.ps1 linguist-language=PowerShell linguist-detectable=true
