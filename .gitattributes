# Auto detect text files and perform LF normalization
* text=auto eol=lf

# ----------------------------------------------------------------------
# GitHub Linguist Language Configuration
# ----------------------------------------------------------------------

# Exclude compiled output, vendored binaries, and archives from language statistics
dist/** linguist-vendored
release/** linguist-vendored
public/** linguist-vendored
node_modules/** linguist-vendored
.system_generated/** linguist-vendored
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ttf binary
*.woff binary
*.woff2 binary
*.msi binary
*.zip binary
*.exe binary
*.dll binary
*.bin binary
*.dat binary

# Exclude markdown docs, index.html template and SVGs from language calculations
docs/** linguist-documentation
*.md linguist-documentation
index.html linguist-documentation
*.svg linguist-documentation

# Primary Platform Development Languages
*.ts linguist-detectable=true
*.tsx linguist-detectable=true
*.css linguist-detectable=true
*.cjs linguist-detectable=true
*.js linguist-detectable=true
*.ps1 linguist-detectable=true
