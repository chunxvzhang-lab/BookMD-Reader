{
  "name": "codex-book-md-viewer",
  "private": true,
  "version": "1.5.0",
  "description": "BookMD Reader - Modern high performance Markdown reader and editor",
  "author": "Codex BookMD Team",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "electron .",
    "desktop:pack": "npm run build && node scripts/package-desktop.cjs",
    "desktop:pack:builder": "npm run build && electron-builder --win portable",
    "desktop:msi": "npm run build && electron-builder --win msi",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.codex.bookmdviewer",
    "productName": "BookMD Reader",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "msi"
      ]
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "runAfterFinish": true,
      "shortcutName": "BookMD Reader"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "jsdom": "^30.0.1",
    "lucide-react": "^0.468.0",
    "markdown-it": "^14.1.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.12.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "vitest": "^4.1.10"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
